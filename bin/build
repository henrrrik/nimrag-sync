#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

# rustup installs cargo in ~/.cargo/bin, which only login shells have on PATH.
command -v cargo >/dev/null 2>&1 || PATH="$HOME/.cargo/bin:$PATH"
cargo build --release --locked --manifest-path "$ROOT/core/Cargo.toml"

mkdir -p "$ROOT/build"
cd "$ROOT/build"
qmake6 "$ROOT/nimrag-sync.pro"
make -j"$(nproc)"

echo "Built $ROOT/build/nimrag-sync"
