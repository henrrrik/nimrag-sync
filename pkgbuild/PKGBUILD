pkgname=nimrag-sync
pkgver=0.1.0
pkgrel=1
pkgdesc='Keep an inReach in sync on Linux: software, contacts, messages and settings'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal' 'libsecret')
makedepends=('gcc' 'make' 'cargo')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/nimrag-sync "$pkgdir/usr/bin/nimrag-sync"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/nimrag-sync.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/nimrag-sync.svg"
  install -Dm644 "$startdir/nimrag-sync.desktop" "$pkgdir/usr/share/applications/nimrag-sync.desktop"
  install -Dm644 "$startdir/70-nimrag-sync.rules" "$pkgdir/usr/lib/udev/rules.d/70-nimrag-sync.rules"
}
